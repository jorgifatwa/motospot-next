# ────────────────────────────────
# RNJ Motospot V2 — Environment Variables
# Source: SECURITY.md Section 7
# Copy this file to .env and fill in real values
# Never commit .env to version control
# ────────────────────────────────

# Database
DATABASE_URL="postgresql://motospot:motospot_dev@localhost:5432/motospot_dev?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL (for Docker Compose)
POSTGRES_USER=motospot
POSTGRES_PASSWORD=motospot_dev
POSTGRES_DB=motospot_dev

# Storage
STORAGE_PATH=./storage

# Booking Expiration (in days, default: 7)
BOOKING_EXPIRATION_DAYS=7